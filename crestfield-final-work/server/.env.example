# HTTP port used by the Express API server. Keep 4000 unless you have a port conflict.
PORT=4000
# Runtime mode; use production on a deployed server.
NODE_ENV=development
# MongoDB connection string; replace host/database if your database is hosted elsewhere.
MONGODB_URI=mongodb://127.0.0.1:27017/university_management_system
# Secret used to sign authentication tokens; generate a unique random value of 32+ characters. Never share or commit a real secret.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# How long an access token remains valid, for example 8h or 1d.
JWT_EXPIRES_IN=8h
# Exact browser origin allowed to call the API; change this for your deployed frontend domain.
CLIENT_ORIGIN=http://localhost:5173 # Must match the browser origin; activation links use this origin
# Email used for the first Super Admin account created by the seed/bootstrap process. Change it to your admin email.
SUPER_ADMIN_EMAIL=admin@university.local
# Strong initial Super Admin password; replace before first use and store it securely.
SUPER_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-14-characters
# Paystack secret key from your Paystack dashboard; required for server-side payment verification. Keep secret, never use a public key here.
PAYSTACK_SECRET_KEY=
# Paystack API base URL; normally leave this unchanged.
PAYSTACK_BASE_URL=https://api.paystack.co
# Gmail: enable Google 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords.
# Use the App Password here, not your normal Google account password. Keep this file private and never commit server/.env.
SMTP_HOST=smtp.gmail.com
# Port 587 uses STARTTLS: begin without implicit TLS, then upgrade; port 465 uses implicit TLS.
SMTP_PORT=587
# Gmail/Google Workspace account that generated the App Password.
SMTP_USER=your-gmail-address@gmail.com
# Paste the Google App Password. Accidental surrounding whitespace and Gmail grouping spaces are normalized.
SMTP_PASSWORD=your_google_app_password
# false for port 587 STARTTLS; true for port 465 implicit TLS.
SMTP_SECURE=false
# Use the same Gmail address as SMTP_USER, or an alias already verified in Gmail Send mail as.
# Placeholder domains such as .local are rejected. The sender is never replaced with a fake address.
SMTP_FROM=your-gmail-address@gmail.com
# Local private upload directory for files that are not stored in the configured private document provider.
UPLOAD_DIR=./private-uploads

# Cloudinary cloud name for private profile/document storage; copy from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
# Cloudinary API key; copy from your dashboard and keep server-side only.
CLOUDINARY_API_KEY=
# Cloudinary API secret; keep private and never place it in client-side variables.
CLOUDINARY_API_SECRET=
